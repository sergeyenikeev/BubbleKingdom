{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@bubble-kingdom/shared": ["packages/shared/src/index.ts"],
      "@bubble-kingdom/config": ["packages/config/src/index.ts"],
      "@bubble-kingdom/analytics": ["packages/analytics/src/index.ts"],
      "@bubble-kingdom/platform-sdk": ["packages/platform-sdk/src/index.ts"],
      "@bubble-kingdom/game-data": ["packages/game-data/src/index.ts"],
      "@bubble-kingdom/game-core": ["packages/game-core/src/index.ts"]
    }
  }
}
