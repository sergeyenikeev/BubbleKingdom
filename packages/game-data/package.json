{
  "name": "@bubble-kingdom/game-data",
  "version": "0.1.0-alpha",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "@bubble-kingdom/config": "workspace:*",
    "@bubble-kingdom/shared": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate:content": "tsx src/validate.ts"
  }
}
